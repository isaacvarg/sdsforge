<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Safety Data Sheet — {{ .Doc.ProductName }}</title>
  <style>
    @page { size: letter; margin: 0.75in; }
    :root {
      --ink: #14161a;
      --muted: #5b6470;
      --rule: #c9ced6;
      --band: #eef1f5;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: "Source Serif 4", Georgia, "Times New Roman", serif;
      font-size: 10.5pt;
      line-height: 1.45;
      color: var(--ink);
      max-width: 7in;
      margin: 0 auto;
      padding: 0.5in 0;
    }
    header.sheet {
      border-bottom: 2px solid var(--ink);
      padding-bottom: 0.6em;
      margin-bottom: 1.4em;
      display: flex;
      align-items: flex-start;
      gap: 4mm;
    }
    /* The headings take the remaining width so a long product name wraps
       against the logo rather than pushing it off the page. */
    header.sheet .headings { flex: 1 1 auto; min-width: 0; }
    /* flex: none so the logo keeps the size it was measured and fitted to. */
    header.sheet img.logo { flex: none; }
    header.sheet .kicker {
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: 8pt;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 0 0 0.3em;
    }
    header.sheet h1 { margin: 0 0 0.25em; font-size: 19pt; font-weight: 600; }
    .meta {
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: 8.5pt;
      color: var(--muted);
      display: flex;
      flex-wrap: wrap;
      gap: 0 1.6em;
    }
    section.sds { margin: 0 0 1.5em; break-inside: avoid; }
    section.sds > h2 {
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: 10.5pt;
      font-weight: 700;
      margin: 0 0 0.5em;
      padding: 0.32em 0.5em;
      background: var(--band);
      border-left: 3px solid var(--ink);
    }
    .subsection { margin: 0 0 0.75em; padding-left: 0.5em; }
    .subsection > h3 {
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: 9pt;
      font-weight: 600;
      color: var(--muted);
      margin: 0 0 0.2em;
      letter-spacing: 0.01em;
    }
    .subsection p { margin: 0 0 0.35em; }
    .subsection p:last-child { margin-bottom: 0; }
    p.empty { color: var(--muted); font-style: italic; }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9pt;
      margin: 0.2em 0 0.4em;
    }
    th, td {
      border: 1px solid var(--rule);
      padding: 0.3em 0.5em;
      text-align: left;
      vertical-align: top;
    }
    th {
      background: var(--band);
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: 8.5pt;
      font-weight: 600;
    }
    .pictograms {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6em 1em;
      margin: 0.3em 0 0.2em;
      break-inside: avoid;
    }
    .pictograms figure {
      margin: 0;
      /* A fixed width keeps captions aligned; without it a long name like
         "skull and crossbones" drags its pictogram out of line with the rest. */
      width: 26mm;
      text-align: center;
      break-inside: avoid;
    }
    .pictograms img {
      /* 20mm is the common label convention and prints legibly. */
      width: 20mm;
      height: 20mm;
      display: block;
      margin: 0 auto;
    }
    .pictograms figcaption {
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: 7.5pt;
      color: var(--muted);
      margin-top: 0.25em;
      line-height: 1.25;
    }
    footer.sheet {
      margin-top: 2em;
      padding-top: 0.6em;
      border-top: 1px solid var(--rule);
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: 8pt;
      color: var(--muted);
    }
  </style>
</head>
<body>

<header class="sheet">
  {{- with .Logo }}
  <img class="logo" src="{{ imageURI .Src }}" alt="{{ .Alt }}" style="{{ .Style }}">
  {{- end }}
  <div class="headings">
    <p class="kicker">Safety Data Sheet</p>
    <h1>{{ .Doc.ProductName }}</h1>
    <div class="meta">
      {{- with .Company.Name }}<span>{{ . }}</span>{{ end }}
      {{- with .Doc.DocumentVersion }}<span>Version {{ . }}</span>{{ end }}
      {{- with .Doc.LastRevision }}<span>Revised {{ . }}</span>{{ end }}
      <span>Generated {{ .GeneratedAt }}</span>
    </div>
  </div>
</header>

{{ range .Sections }}
<section class="sds">
  <h2>{{ .Number }}. {{ .Title }}</h2>
  {{ range .Subsections }}
  <div class="subsection">
    <h3>{{ .Title }}</h3>
    {{ template "block" . }}
  </div>
  {{ end }}
</section>
{{ end }}

<footer class="sheet">
  <p>{{ with .Company.Name }}Prepared by {{ . }}. {{ end }}Generated by sdsforge
  on {{ .GeneratedAt }}. Prepared in the format of the OSHA Hazard Communication
  Standard, 29 CFR 1910.1200.</p>
</footer>

</body>
</html>
